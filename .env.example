# --- Hetzner Inference API (https://experiments.hetzner.com/) ---
# Crea el token en el dashboard de Experiments.
HETZNER_INFERENCE_API_KEY=tu_token_de_hetzner
HETZNER_INFERENCE_BASE_URL=https://inference.hetzner.com/api/v1
# Modelos disponibles: Qwen/Qwen3.6-35B-A3B-FP8 (MoE, rápido) o Qwen3.8-27B (denso)
HETZNER_INFERENCE_MODEL=Qwen/Qwen3.6-35B-A3B-FP8

# --- YouTube ---
# Acepta URL del canal, handle (@MeetKevin) o ID de canal (UC...)
YOUTUBE_CHANNEL_ID=https://www.youtube.com/@MeetKevin
# Idiomas de subtítulos a intentar, por orden de preferencia (manuales primero, luego automáticos)
SUBTITLE_LANGUAGES=en,es
# Cuántos vídeos recientes se consultan en cada pasada
CHECK_LATEST_N=10
# Máximo de vídeos a procesar por pasada (para no reventar el rate limit de Hetzner: 10 req/min)
MAX_VIDEOS_PER_RUN=3
# En la primera ejecución (sin state.json) solo se procesan los N vídeos más recientes; el resto se marcan como vistos
FIRST_RUN_VIDEOS=1
# Si un vídeo aún no tiene subtítulos (recién subido), se reintenta durante estas horas antes de descartarlo
GIVE_UP_AFTER_HOURS=48
# Opcional. Normalmente no hace falta. Solo si YouTube empieza a devolver
# "Sign in to confirm you're not a bot" (suele pasar tras muchas peticiones seguidas o desde IPs de datacenter):
#  a) Leer las cookies de tu navegador (chrome, firefox, safari, brave, edge; opcional ":perfil")
# YTDLP_COOKIES_FROM_BROWSER=firefox
#  b) Fichero de cookies en formato Netscape exportado con una extensión tipo "Get cookies.txt LOCALLY"
# YTDLP_COOKIES_FILE=cookies.txt

# --- Telegram ---
# Token de @BotFather
TELEGRAM_BOT_API_KEY=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Chat al que enviar. Escribe algo a tu bot y ejecuta: python main.py --get-chat-id
TELEGRAM_CHAT_ID=

# --- Resumen ---
SUMMARY_LANGUAGE=español
# Minutos entre pasadas cuando se ejecuta en modo bucle (sin --once)
POLL_INTERVAL_MINUTES=30
# Fichero de estado
STATE_FILE=state.json
